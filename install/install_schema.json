{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "arpi_access": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "description": "Hostname or IP address of the target device"
        },
        "password": {
          "type": "string",
          "description": "Password or key passphrase for SSH authentication"
        },
        "deploy_ssh_key": {
          "type": "boolean",
          "description": "Whether to deploy SSH keys during installation"
        },
        "disable_ssh_password_authentication": {
          "type": "boolean",
          "description": "Whether to disable password authentication after key deployment"
        }
      },
      "required": [
        "hostname",
        "deploy_ssh_key",
        "disable_ssh_password_authentication"
      ],
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": ["content", "name", "username"],
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "properties": {
        "board_version": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3
        },
        "server_environment": {
          "type": "string"
        },
        "webapplication_path": {
          "type": "string"
        },
        "extra_packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "server_environment",
        "webapplication_path",
        "extra_packages"
      ],
      "additionalProperties": false
    }
  },
  "required": ["arpi_access", "database", "deployment"],
  "additionalProperties": false
}
